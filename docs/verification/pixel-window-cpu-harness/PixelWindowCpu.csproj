<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(RendererDirectory)/*.dll" Exclude="$(RendererDirectory)/PixelMap.Rendering.Tests.dll" />
    <Content Include="$(RendererDirectory)/runtimes/linux-x64/native/libSkiaSharp.so"
             Link="libSkiaSharp.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Imagery/*.jpg" LogicalName="PixelMap.Imagery.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Seed/*.pbf.gz" LogicalName="PixelMap.Seed.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

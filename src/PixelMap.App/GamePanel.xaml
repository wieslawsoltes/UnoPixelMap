<UserControl
    x:Class="PixelMap.App.GamePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PixelMap.App">
    <UserControl.Resources>
        <Style x:Key="GameAction" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#E5ECD9" />
            <Setter Property="Foreground" Value="#193938" />
            <Setter Property="BorderBrush" Value="#AFBFAB" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="TouchAction" TargetType="Button" BasedOn="{StaticResource GameAction}">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="#ED193D3B" />
            <Setter Property="Foreground" Value="#F8F4DE" />
            <Setter Property="BorderBrush" Value="#7EAA94" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="SettingsCard" Width="326" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                Padding="12,9" Background="#F7FFFBEE" BorderBrush="#708F7D" BorderThickness="1" CornerRadius="7">
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Title" Text="Free roam" FontSize="17" FontWeight="SemiBold" Foreground="#193938" />
                        <TextBlock Text="EXPLORE THE WORLD" FontSize="9" CharacterSpacing="100" Foreground="#466D5C" />
                    </StackPanel>
                    <Button x:Name="SettingsToggle" Grid.Column="1" Content="−" Style="{StaticResource GameAction}"
                            Width="34" Padding="0" Click="OnToggleSettings" AutomationProperties.Name="Collapse game settings" />
                    <Button x:Name="ExitButton" Grid.Column="2" Content="×" Style="{StaticResource GameAction}" Width="34" Padding="0"
                            Click="OnClose" AutomationProperties.Name="Exit free roam" />
                </Grid>
                <StackPanel x:Name="Setup" Spacing="7">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <ComboBox x:Name="ModeChoice" Header="Move as" SelectedIndex="0" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnModeChanged" AutomationProperties.Name="Free roam vehicle">
                            <ComboBoxItem Tag="Walk" Content="Walk" />
                            <ComboBoxItem Tag="Drive" Content="Car" />
                            <ComboBoxItem Tag="Bike" Content="Bicycle" />
                            <ComboBoxItem Tag="Boat" Content="Boat" />
                            <ComboBoxItem Tag="Flight" Content="Aircraft" />
                            <ComboBoxItem Tag="Train" Content="Train" />
                            <ComboBoxItem Tag="FreeFlight" Content="Free flight" />
                        </ComboBox>
                        <ComboBox x:Name="CameraChoice" Grid.Column="1" Header="Camera" SelectedIndex="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnCameraChanged" AutomationProperties.Name="Free roam camera">
                            <ComboBoxItem Tag="Chase" Content="Third person" />
                            <ComboBoxItem Tag="FirstPerson" Content="First person" />
                            <ComboBoxItem Tag="Cockpit" Content="Cockpit" />
                            <ComboBoxItem Tag="Orbit" Content="Orbit" />
                            <ComboBoxItem Tag="NorthUp" Content="North up" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <ComboBox x:Name="StyleChoice" Header="Graphics" SelectedIndex="0" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnStyleChanged" AutomationProperties.Name="Game rendering style">
                            <ComboBoxItem Tag="Pixel" Content="Pixel art" />
                            <ComboBoxItem Tag="Normal" Content="Normal" />
                            <ComboBoxItem Tag="Minecraft" Content="Minecraft" />
                            <ComboBoxItem Tag="Roblox" Content="Roblox" />
                        </ComboBox>
                        <ComboBox x:Name="LayerChoice" Grid.Column="1" Header="World layer" SelectedIndex="0" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnLayerChanged" AutomationProperties.Name="Game map layer">
                            <ComboBoxItem Tag="Map" Content="Map" />
                            <ComboBoxItem Tag="Earth" Content="Earth" />
                            <ComboBoxItem Tag="Elevation" Content="Elevation" />
                        </ComboBox>
                    </Grid>
                    <ToggleSwitch x:Name="Relief" Header="Terrain relief" IsOn="True" Toggled="OnReliefChanged"
                                  AutomationProperties.Name="Game terrain relief" />
                    <Button x:Name="StartButton" Content="Start walking here" Style="{StaticResource GameAction}" Click="OnStart"
                            HorizontalAlignment="Stretch" Background="#245D4D" Foreground="#FFFBEE" BorderBrush="#245D4D"
                            AutomationProperties.Name="Start free roam at map center" />
                    <TextBlock x:Name="ControlsHint" Foreground="#496557" FontSize="11" TextWrapping="Wrap"
                               Text="WASD moves · drag to look · Space jumps · Shift runs. Use both sticks on touch." />
                </StackPanel>
                <Border x:Name="TelemetryBox" Visibility="Collapsed" Background="#E7EDDA" Padding="8,5" CornerRadius="4">
                    <TextBlock x:Name="Telemetry" Foreground="#294C42" FontSize="11" TextWrapping="Wrap"
                               AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <Grid x:Name="Transport" Visibility="Collapsed" ColumnDefinitions="*,*,Auto" ColumnSpacing="5">
                    <Button x:Name="PauseButton" Content="Pause" Style="{StaticResource GameAction}" Click="OnPause"
                            AutomationProperties.Name="Pause free roam" />
                    <Button x:Name="RespawnButton" Grid.Column="1" Content="Respawn" Style="{StaticResource GameAction}" Click="OnRespawn"
                            AutomationProperties.Name="Respawn free roam vehicle" />
                    <ToggleButton x:Name="Sound" Grid.Column="2" Content="Sound" MinHeight="38" Padding="8,3" CornerRadius="4"
                                  Click="OnSound" AutomationProperties.Name="Free roam sound" />
                </Grid>
            </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid x:Name="Reticle" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
              IsHitTestVisible="False" Visibility="Collapsed" Opacity=".85" AutomationProperties.AccessibilityView="Raw">
            <Border Width="18" Height="4" Background="#AA173938" VerticalAlignment="Center" />
            <Border Width="4" Height="18" Background="#AA173938" HorizontalAlignment="Center" />
            <Border Width="14" Height="2" Background="#FFFFF8E7" VerticalAlignment="Center" />
            <Border Width="2" Height="14" Background="#FFFFF8E7" HorizontalAlignment="Center" />
        </Grid>
        <Grid x:Name="TouchPad" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="16,0,16,12"
              ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
            <StackPanel Spacing="2" VerticalAlignment="Bottom">
                <TextBlock Text="MOVE" Foreground="#FFFAE4" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <local:GameStick x:Name="MoveStick" AutomationProperties.Name="Free roam movement stick" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                <StackPanel x:Name="FlightActions" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <Button x:Name="Climb" Content="Up" Style="{StaticResource TouchAction}" AutomationProperties.Name="Free roam climb" />
                    <Button x:Name="Descend" Content="Down" Style="{StaticResource TouchAction}" AutomationProperties.Name="Free roam descend" />
                </StackPanel>
                <Button x:Name="JumpBrake" Content="Jump" Style="{StaticResource TouchAction}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Free roam jump or brake" />
                <Button x:Name="Boost" Content="Boost" Style="{StaticResource TouchAction}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Free roam boost" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Bottom">
                <TextBlock Text="LOOK" Foreground="#FFFAE4" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <local:GameStick x:Name="LookStick" AutomationProperties.Name="Free roam look stick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<UserControl
    x:Class="PixelMap.App.GamePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PixelMap.App"
    AutomationProperties.Name="Free roam game">
    <UserControl.Resources>
        <Style x:Key="GameAction" TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#F1F2F6" />
            <Setter Property="Foreground" Value="#007AFF" />
            <Setter Property="BorderBrush" Value="#1F3C3C43" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <Style x:Key="TouchAction" TargetType="Button" BasedOn="{StaticResource GameAction}">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="#007AFF" />
            <Setter Property="BorderBrush" Value="#1F3C3C43" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="Reticle" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
              IsHitTestVisible="False" Visibility="Collapsed" Opacity=".85" AutomationProperties.AccessibilityView="Raw">
            <Border Width="18" Height="4" Background="#AA173938" VerticalAlignment="Center" />
            <Border Width="4" Height="18" Background="#AA173938" HorizontalAlignment="Center" />
            <Border Width="14" Height="2" Background="#FFFFF8E7" VerticalAlignment="Center" />
            <Border Width="2" Height="14" Background="#FFFFF8E7" HorizontalAlignment="Center" />
        </Grid>
        <Border x:Name="SettingsCard" Width="360" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                Padding="16,12" Background="#F7FFFFFF" BorderBrush="#1F3C3C43" BorderThickness="1" CornerRadius="20"
                AutomationProperties.Name="Free roam settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Free roam settings content">
            <StackPanel x:Name="SettingsContent" Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                    <StackPanel VerticalAlignment="Center">
                        <Border AutomationProperties.Name="Free roam">
                            <TextBlock x:Name="Title" Text="Free roam" FontSize="22" FontWeight="SemiBold" Foreground="#1C1C1E"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </Border>
                        <TextBlock Text="Choose how you explore" FontSize="12" Foreground="#636366" />
                    </StackPanel>
                    <Button x:Name="SettingsToggle" Grid.Column="1" Content="−" Style="{StaticResource GameAction}"
                            Width="44" Padding="0" Click="OnToggleSettings" AutomationProperties.Name="Collapse game settings" />
                    <Button Grid.Column="2" Content="×" Style="{StaticResource GameAction}" Width="44" Padding="0"
                            Click="OnClose" AutomationProperties.Name="Exit free roam" />
                </Grid>
                <StackPanel x:Name="Setup" Spacing="10">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <ComboBox x:Name="ModeChoice" Header="Move as" SelectedIndex="0" MinWidth="0" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnModeChanged" AutomationProperties.Name="Free roam vehicle">
                            <ComboBoxItem Tag="Walk" Content="Walk" />
                            <ComboBoxItem Tag="Drive" Content="Car" />
                            <ComboBoxItem Tag="Bike" Content="Bicycle" />
                            <ComboBoxItem Tag="Boat" Content="Boat" />
                            <ComboBoxItem Tag="Flight" Content="Aircraft" />
                            <ComboBoxItem Tag="Train" Content="Train" />
                            <ComboBoxItem Tag="FreeFlight" Content="Free flight" />
                        </ComboBox>
                        <ComboBox x:Name="CameraChoice" Grid.Column="1" Header="Camera" SelectedIndex="1" MinWidth="0" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnCameraChanged" AutomationProperties.Name="Free roam camera">
                            <ComboBoxItem Tag="Chase" Content="Third person" />
                            <ComboBoxItem Tag="FirstPerson" Content="First person" />
                            <ComboBoxItem Tag="Cockpit" Content="Cockpit" />
                            <ComboBoxItem Tag="Orbit" Content="Orbit" />
                            <ComboBoxItem Tag="NorthUp" Content="North up" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <ComboBox x:Name="StyleChoice" Header="Graphics" SelectedIndex="0" MinWidth="0" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnStyleChanged" AutomationProperties.Name="Game rendering style">
                            <ComboBoxItem Tag="Pixel" Content="Pixel art" />
                            <ComboBoxItem Tag="Normal" Content="Normal" />
                            <ComboBoxItem Tag="Minecraft" Content="Minecraft" />
                            <ComboBoxItem Tag="Roblox" Content="Roblox" />
                        </ComboBox>
                        <ComboBox x:Name="LayerChoice" Grid.Column="1" Header="World layer" SelectedIndex="0" MinWidth="0" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnLayerChanged" AutomationProperties.Name="Game map layer">
                            <ComboBoxItem Tag="Map" Content="Map" />
                            <ComboBoxItem Tag="Earth" Content="Earth" />
                            <ComboBoxItem Tag="Elevation" Content="Elevation" />
                        </ComboBox>
                    </Grid>
                    <ToggleSwitch x:Name="Relief" Header="Terrain relief" IsOn="True" Toggled="OnReliefChanged"
                                  AutomationProperties.Name="Game terrain relief" />
                    <Button x:Name="StartButton" Content="Start walking here" Style="{StaticResource GameAction}" Click="OnStart"
                            HorizontalAlignment="Stretch" Background="#007AFF" Foreground="#FFFFFF" BorderBrush="#007AFF" MinHeight="48" FontSize="15"
                            AutomationProperties.Name="Start free roam at map center" />
                    <TextBlock x:Name="ControlsHint" Foreground="#636366" FontSize="12" TextWrapping="Wrap"
                               Text="WASD moves · drag to look · Space jumps · Shift runs. Use both sticks on touch." />
                </StackPanel>
                <Border x:Name="TelemetryBox" Visibility="Collapsed" Background="#F1F2F6" Padding="10,8" CornerRadius="12">
                    <TextBlock x:Name="Telemetry" Foreground="#3A3A3C" FontSize="12" TextWrapping="Wrap"
                               AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <Grid x:Name="Transport" Visibility="Collapsed" ColumnDefinitions="*,*,Auto" ColumnSpacing="5"
                      AutomationProperties.Name="Free roam playback controls">
                    <Button x:Name="PauseButton" Content="Pause" Style="{StaticResource GameAction}" Click="OnPause"
                            AutomationProperties.Name="Pause free roam" />
                    <Button Grid.Column="1" Content="Respawn" Style="{StaticResource GameAction}" Click="OnRespawn"
                            AutomationProperties.Name="Respawn free roam vehicle" />
                    <ToggleButton x:Name="Sound" Grid.Column="2" Content="Sound" MinHeight="44" Padding="8,3" CornerRadius="4"
                                  Click="OnSound" AutomationProperties.Name="Free roam sound" />
                </Grid>
            </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid x:Name="TouchPad" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="16,0,16,12"
              ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5" AutomationProperties.Name="Free roam touch controls">
            <StackPanel Spacing="2" VerticalAlignment="Bottom" AutomationProperties.Name="Free roam movement controls">
                <TextBlock Text="MOVE" Foreground="#1C1C1E" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <local:GameStick x:Name="MoveStick" AutomationProperties.Name="Free roam movement stick" />
            </StackPanel>
            <StackPanel x:Name="PadActions" Grid.Column="1" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,10" AutomationProperties.Name="Free roam action controls">
                <StackPanel x:Name="FlightActions" Orientation="Horizontal" Spacing="4" Visibility="Collapsed"
                            AutomationProperties.Name="Free roam altitude controls">
                    <Button x:Name="Climb" Content="Up" Style="{StaticResource TouchAction}" AutomationProperties.Name="Free roam climb" />
                    <Button x:Name="Descend" Content="Down" Style="{StaticResource TouchAction}" AutomationProperties.Name="Free roam descend" />
                </StackPanel>
                <Button x:Name="JumpBrake" Content="Jump" Style="{StaticResource TouchAction}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Free roam jump or brake" />
                <Button x:Name="Boost" Content="Boost" Style="{StaticResource TouchAction}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Free roam boost" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Bottom" AutomationProperties.Name="Free roam look controls">
                <TextBlock Text="LOOK" Foreground="#1C1C1E" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <local:GameStick x:Name="LookStick" AutomationProperties.Name="Free roam look stick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

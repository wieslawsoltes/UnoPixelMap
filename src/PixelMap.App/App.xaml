<Application x:Class="PixelMap.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#007AFF</Color>
            <SolidColorBrush x:Key="AtlasAccentBrush" Color="#007AFF" />
            <SolidColorBrush x:Key="AtlasInkBrush" Color="#1C1C1E" />
            <SolidColorBrush x:Key="AtlasSecondaryBrush" Color="#636366" />
            <SolidColorBrush x:Key="AtlasSurfaceBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="AtlasGroupedBrush" Color="#F1F2F6" />
            <SolidColorBrush x:Key="AtlasSeparatorBrush" Color="#1F3C3C43" />
            <Style TargetType="Button">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="{StaticResource AtlasGroupedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AtlasAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="AtlasIconButton" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource AtlasAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="21" />
            </Style>
            <Style x:Key="AtlasPrimaryButton" TargetType="Button">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{StaticResource AtlasAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="{StaticResource AtlasGroupedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AtlasInkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AtlasSeparatorBrush}" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource AtlasInkBrush}" />
                <Setter Property="Background" Value="{StaticResource AtlasGroupedBrush}" />
            </Style>
            <Style TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Foreground" Value="{StaticResource AtlasAccentBrush}" />
                <Setter Property="Background" Value="{StaticResource AtlasGroupedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style TargetType="MenuFlyoutItem"><Setter Property="MinHeight" Value="44" /></Style>
            <Style TargetType="ToggleMenuFlyoutItem"><Setter Property="MinHeight" Value="44" /></Style>
            <Style TargetType="MenuFlyoutSubItem"><Setter Property="MinHeight" Value="44" /></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Page
    x:Class="PixelMap.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maps="using:PixelMap.Controls"
    xmlns:local="using:PixelMap.App"
    RequestedTheme="Light" Background="#DCE5E3">
    <Page.Resources>
        <Style x:Key="MapAction" TargetType="Button" BasedOn="{StaticResource AtlasIconButton}" />
        <Style x:Key="ExploreAction" TargetType="Button">
            <Setter Property="MinHeight" Value="64" /><Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="13" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource AtlasGroupedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AtlasInkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>
    <Grid x:Name="MapArea" Background="#DCE5E3" AutomationProperties.Name="Map explorer">
        <maps:PixelMapControl x:Name="Map" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              AutomationProperties.Name="Interactive world map" />

        <!-- One compact surface becomes a bottom sheet; the map keeps its full viewport. -->
        <Border x:Name="SidebarSurface" Width="360" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                Padding="16,6,16,16" CornerRadius="22" Background="{StaticResource AtlasSurfaceBrush}"
                BorderBrush="{StaticResource AtlasSeparatorBrush}" BorderThickness="1"
                AutomationProperties.Name="Search and directions"
                Tapped="OnChromeTapped" DoubleTapped="OnChromeDoubleTapped" PointerWheelChanged="OnChromeWheel">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Height="44" ColumnDefinitions="*,44" AutomationProperties.Name="Map toolbar">
                    <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Viewbox Width="25" Height="25" AutomationProperties.Name="Pixel Atlas">
                            <Canvas Width="32" Height="32">
                                <Path Fill="#73B8FF" Data="M0,10 L16,2 L32,10 L16,18 Z" />
                                <Path Fill="#007AFF" Data="M0,11 L15,19 L15,27 L0,19 Z" />
                                <Path Fill="#3B99FF" Data="M17,19 L32,11 L32,19 L17,27 Z" />
                                <Path Fill="#E9F4FF" Data="M9,8 L17,4 L25,8 L17,12 Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Pixel Atlas" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource AtlasInkBrush}" />
                    </StackPanel>
                    <Button x:Name="SheetHandle" Grid.ColumnSpan="2" HorizontalAlignment="Center" Width="120" Height="44"
                            Style="{StaticResource AtlasIconButton}" Visibility="Collapsed" Click="OnSheetToggle"
                            KeyDown="OnSheetKey" AutomationProperties.Name="Expand search sheet"
                            ToolTipService.ToolTip="Drag or use arrow keys to resize the search sheet">
                        <Border Width="36" Height="5" CornerRadius="3" Background="#C7C7CC" />
                    </Button>
                    <Button x:Name="SidebarCloseButton" Grid.Column="1" Content="×" FontSize="24"
                            Style="{StaticResource AtlasIconButton}" Foreground="#8E8E93" Click="OnHideSidebar"
                            AutomationProperties.Name="Hide search panel" ToolTipService.ToolTip="Hide search panel" />
                </Grid>
                <StackPanel x:Name="SearchOverlay" Grid.Row="1" Margin="0,6,0,12">
                    <Border Background="{StaticResource AtlasGroupedBrush}" CornerRadius="12" Padding="2">
                        <Grid ColumnDefinitions="*,44">
                            <TextBox x:Name="SearchBox" PlaceholderText="Search places or coordinates" MaxLength="200" FontSize="16"
                                     Background="Transparent" BorderThickness="0" Padding="12,10" MinHeight="44"
                                     AutomationProperties.Name="Search places or latitude and longitude" KeyDown="OnSearchKey"
                                     TextChanged="OnQueryEdited" GotFocus="OnSearchFocused" />
                            <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource AtlasIconButton}" Click="OnSearch"
                                    AutomationProperties.Name="Search map" ToolTipService.ToolTip="Search">
                                <Path Stroke="#8E8E93" StrokeThickness="1.8" Data="M13,7 A6,6 0 1 1 1,7 A6,6 0 1 1 13,7 M11.5,11.5 L18,18" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
                <Grid x:Name="SidebarContent" Grid.Row="2">
                    <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="HomePane" Spacing="12">
                            <Border x:Name="PlaceCard" Padding="0,4,0,0">
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="PlaceEyebrow" Text="Explore the map" Foreground="{StaticResource AtlasSecondaryBrush}" FontSize="13" />
                                    <TextBlock x:Name="Destination" Text="Lower Manhattan" FontSize="25" FontWeight="SemiBold"
                                               Foreground="{StaticResource AtlasInkBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DestinationDetail" Text="New York City, United States" FontSize="14"
                                               Foreground="{StaticResource AtlasSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MobileStatus" FontSize="11" Foreground="{StaticResource AtlasSecondaryBrush}"
                                               TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Style="{StaticResource AtlasPrimaryButton}" Click="OnJourneys" AutomationProperties.Name="Open route planner">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="White" StrokeThickness="1.8"
                                              Data="M3,18 L3,8 Q3,4 7,4 L17,4 M13,0 L18,4 L13,8 M7,18 L14,18 Q18,18 18,14 L18,11" />
                                        <TextBlock Text="Directions" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Content="Share" Click="OnShare" HorizontalAlignment="Stretch" FontSize="15" FontWeight="SemiBold"
                                        AutomationProperties.Name="Share current view" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button x:Name="GuideButton" Style="{StaticResource ExploreAction}" Click="OnGuide" AutomationProperties.Name="Browse city guide">
                                    <StackPanel Spacing="7"><Path Stroke="#007AFF" StrokeThickness="1.7" Width="22" Height="20" Stretch="Uniform" Data="M1,2 L7,0 L14,3 L21,0 L21,17 L14,20 L7,17 L1,20 Z M7,0 L7,17 M14,3 L14,20" /><TextBlock Text="City guides" FontWeight="SemiBold" FontSize="14" /></StackPanel>
                                </Button>
                                <Button x:Name="GameButton" Grid.Column="1" Style="{StaticResource ExploreAction}" Click="OnGame" AutomationProperties.Name="Open free roam game">
                                    <StackPanel Spacing="7"><Path Stroke="#007AFF" StrokeThickness="1.7" Width="22" Height="20" Stretch="Uniform" Data="M8,4 A2,2 0 1 1 12,4 A2,2 0 1 1 8,4 M10,8 L7,13 L2,15 M10,8 L15,11 L19,10 M8,12 L11,16 L10,22 M8,12 L5,17 L1,20" /><TextBlock Text="Free roam" FontWeight="SemiBold" FontSize="14" /></StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel Spacing="9">
                                <TextBlock Text="Explore cities" Foreground="{StaticResource AtlasSecondaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                    <Button Tag="0" Click="OnFeaturedPlace" Style="{StaticResource ExploreAction}" AutomationProperties.Name="Explore Lower Manhattan"><StackPanel Spacing="5"><TextBlock Text="NY" FontSize="20" Foreground="#007AFF" FontWeight="SemiBold" /><TextBlock Text="New York" FontSize="12" /></StackPanel></Button>
                                    <Button Grid.Column="1" Tag="4" Click="OnFeaturedPlace" Style="{StaticResource ExploreAction}" AutomationProperties.Name="Explore Paris"><StackPanel Spacing="5"><TextBlock Text="PA" FontSize="20" Foreground="#AF52DE" FontWeight="SemiBold" /><TextBlock Text="Paris" FontSize="12" /></StackPanel></Button>
                                    <Button Grid.Column="2" Tag="2" Click="OnFeaturedPlace" Style="{StaticResource ExploreAction}" AutomationProperties.Name="Explore Tokyo"><StackPanel Spacing="5"><TextBlock Text="TY" FontSize="20" Foreground="#FF9500" FontWeight="SemiBold" /><TextBlock Text="Tokyo" FontSize="12" /></StackPanel></Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="Drawer" Visibility="Collapsed" RowDefinitions="Auto,*,Auto">
                        <Grid ColumnDefinitions="*,44" Margin="0,0,0,8">
                            <TextBlock x:Name="DrawerHeading" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource AtlasInkBrush}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="×" Style="{StaticResource AtlasIconButton}" Foreground="#8E8E93"
                                    Click="OnCloseDrawer" AutomationProperties.Name="Close panel" />
                        </Grid>
                        <ScrollViewer x:Name="ResultScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Rows" Spacing="6" />
                        </ScrollViewer>
                        <TextBlock x:Name="DrawerNote" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource AtlasSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Grid>
                <local:JourneyPanel x:Name="JourneyPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Button x:Name="JourneyPeek" Grid.Row="1" Visibility="Collapsed" Content="Directions · Expand for route"
                        HorizontalAlignment="Stretch" Click="OnSheetToggle" AutomationProperties.Name="Expand directions sheet" />
            </Grid>
        </Border>

        <Button x:Name="OpenSidebarButton" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                Background="{StaticResource AtlasSurfaceBrush}" BorderBrush="{StaticResource AtlasSeparatorBrush}" BorderThickness="1"
                CornerRadius="15" Padding="14,10" Click="OnShowSidebar" AutomationProperties.Name="Show search panel">
            <StackPanel Orientation="Horizontal" Spacing="9"><Path Stroke="#007AFF" StrokeThickness="1.8" Data="M13,7 A6,6 0 1 1 1,7 A6,6 0 1 1 13,7 M11.5,11.5 L18,18" /><TextBlock Text="Search" VerticalAlignment="Center" FontSize="15" /></StackPanel>
        </Button>

        <StackPanel x:Name="SceneDock" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Spacing="10"
                    AutomationProperties.Name="Map layers and location">
            <Border Background="{StaticResource AtlasSurfaceBrush}" BorderBrush="{StaticResource AtlasSeparatorBrush}" BorderThickness="1" CornerRadius="15" Padding="2">
                <StackPanel x:Name="LayerStack">
                    <Button x:Name="LayersButton" Style="{StaticResource MapAction}" AutomationProperties.Name="Choose map layers" ToolTipService.ToolTip="Map layers">
                        <Path Stroke="#007AFF" StrokeThickness="1.7" Width="23" Height="23" Stretch="Uniform" Data="M1,7 L12,1 L23,7 L12,13 Z M1,12 L12,18 L23,12 M1,17 L12,23 L23,17" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="278" Spacing="14" AutomationProperties.Name="Map layers and projection">
                                    <TextBlock Text="Choose a map" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AtlasInkBrush}" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <ToggleButton x:Name="MapLayerButton" IsChecked="True" MinHeight="72" HorizontalAlignment="Stretch" Click="OnMapLayer" AutomationProperties.Name="Map layer"><StackPanel Spacing="6"><Path Width="24" Height="24" Stretch="Uniform" Fill="#5AC8A8" Data="M0,7 L8,2 L16,7 L8,12 Z M0,10 L8,15 L16,10 L16,13 L8,18 L0,13 Z" /><TextBlock Text="Map" FontSize="13" /></StackPanel></ToggleButton>
                                        <ToggleButton x:Name="EarthLayerButton" Grid.Column="1" MinHeight="72" HorizontalAlignment="Stretch" Click="OnEarthLayer" AutomationProperties.Name="Earth imagery layer"><StackPanel Spacing="6"><Grid Width="24" Height="24"><Ellipse Fill="#55A7DC" /><Path Fill="#B4D7A1" Data="M5,4 L13,2 L17,6 L11,10 L13,14 L7,16 L3,10 Z M17,14 L23,12 L23,18 L19,23 L15,21 Z" /></Grid><TextBlock Text="Earth" FontSize="13" /></StackPanel></ToggleButton>
                                        <ToggleButton x:Name="ElevationLayerButton" Grid.Column="2" MinHeight="72" HorizontalAlignment="Stretch" Click="OnElevationLayer" AutomationProperties.Name="Elevation layer"><StackPanel Spacing="6"><Path Width="24" Height="24" Stretch="Uniform" Fill="#A9AA86" Data="M0,13 L6,1 L10,8 L12,5 L17,13 Z M4,6 L6,3 L8,6 L6,5 Z" /><TextBlock Text="Elevation" FontSize="12" /></StackPanel></ToggleButton>
                                    </Grid>
                                    <Border x:Name="ElevationLegend" Visibility="Collapsed" Padding="10" CornerRadius="10" Background="{StaticResource AtlasGroupedBrush}">
                                        <StackPanel Spacing="6"><TextBlock x:Name="ElevationReadout" Foreground="{StaticResource AtlasInkBrush}" FontSize="12" /><Grid ColumnDefinitions="*,*,*,*,*,*,*" Height="7"><Border Background="#426A83" /><Border Grid.Column="1" Background="#719C78" /><Border Grid.Column="2" Background="#A6B47C" /><Border Grid.Column="3" Background="#C2AC80" /><Border Grid.Column="4" Background="#A79691" /><Border Grid.Column="5" Background="#D9D9D0" /><Border Grid.Column="6" Background="#F0EEE5" /></Grid><TextBlock Text="−500       0       1500      3000      6000 m" FontSize="10" Foreground="{StaticResource AtlasSecondaryBrush}" /></StackPanel>
                                    </Border>
                                    <TextBlock Text="For pixel art, lighting and rendering quality, open Map appearance." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource AtlasSecondaryBrush}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Border x:Name="LayerDivider" Height="1" Margin="8,0" Background="{StaticResource AtlasSeparatorBrush}" />
                    <Button x:Name="ViewButton" Style="{StaticResource MapAction}" AutomationProperties.Name="Map appearance" ToolTipService.ToolTip="Map appearance">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutSubItem Text="Rendering style">
                                <ToggleMenuFlyoutItem x:Name="PixelStyleItem" Text="Pixel art rendering" Tag="Pixel" IsChecked="True" Click="OnRenderStyle" />
                                <ToggleMenuFlyoutItem x:Name="NormalStyleItem" Text="Normal rendering" Tag="Normal" Click="OnRenderStyle" />
                                <ToggleMenuFlyoutItem x:Name="MinecraftStyleItem" Text="Minecraft rendering" Tag="Minecraft" Click="OnRenderStyle" />
                                <ToggleMenuFlyoutItem x:Name="RobloxStyleItem" Text="Roblox rendering" Tag="Roblox" Click="OnRenderStyle" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="Rendering quality">
                                <ToggleMenuFlyoutItem x:Name="BalancedQualityItem" Text="Balanced quality" Tag="Balanced" Click="OnRenderingQuality" />
                                <ToggleMenuFlyoutItem x:Name="HighQualityItem" Text="High quality" Tag="High" IsChecked="True" Click="OnRenderingQuality" />
                                <ToggleMenuFlyoutItem x:Name="UltraQualityItem" Text="Ultra quality" Tag="Ultra" Click="OnRenderingQuality" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="Lighting">
                                <ToggleMenuFlyoutItem x:Name="DayItem" Text="Daylight" Tag="Day" IsChecked="True" Click="OnPalette" />
                                <ToggleMenuFlyoutItem x:Name="DuskItem" Text="Golden hour" Tag="Dusk" Click="OnPalette" />
                                <ToggleMenuFlyoutItem x:Name="NightItem" Text="After dark" Tag="Night" Click="OnPalette" />
                            </MenuFlyoutSubItem>
                            <ToggleMenuFlyoutItem x:Name="TerrainReliefItem" Text="Terrain relief" Click="OnTerrainRelief"
                                                 ToolTipService.ToolTip="Render real elevation beneath Map, Earth or Elevation with height-aware camera and journeys." />
                            <MenuFlyoutSubItem Text="Camera">
                                <ToggleMenuFlyoutItem x:Name="PerspectiveItem" Text="Perspective lens" Click="OnPerspective" />
                                <MenuFlyoutItem Text="Camera angles and orbit" Click="OnCameraTools" />
                                <MenuFlyoutItem Text="Rotate left 45 degrees" Click="OnRotateLeft" />
                                <MenuFlyoutItem Text="Rotate right 45 degrees" Click="OnRotateRight" />
                                <MenuFlyoutItem x:Name="ProjectionItem" Text="Switch to overhead view" Click="OnProjection" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="City guide" Click="OnGuide" />
                            <MenuFlyoutItem Text="Share this view" Click="OnShare" />
                            <MenuFlyoutItem Text="Map controls" Click="OnHelp" />
                        </MenuFlyout>
                    </Button.Flyout>
                        <Path Stroke="#007AFF" StrokeThickness="1.8" Width="23" Height="23" Stretch="Uniform" Data="M2,5 L22,5 M2,12 L22,12 M2,19 L22,19 M8,2 L8,8 M17,9 L17,15 M10,16 L10,22" />
                    </Button>
                </StackPanel>
            </Border>
            <Border x:Name="MapTools" Background="{StaticResource AtlasSurfaceBrush}" BorderBrush="{StaticResource AtlasSeparatorBrush}" BorderThickness="1" Padding="2" CornerRadius="15">
                <StackPanel x:Name="ToolStack" Spacing="0">
                    <Button x:Name="LocateButton" Style="{StaticResource MapAction}" Click="OnLocate" AutomationProperties.Name="Show current location" ToolTipService.ToolTip="My location"><Path Stroke="#007AFF" StrokeThickness="1.8" Width="21" Height="21" Stretch="Uniform" Data="M2,10 L22,2 L14,22 L10,14 Z" /></Button>
                    <Border Height="1" Margin="8,0" Background="{StaticResource AtlasSeparatorBrush}" />
                    <Button Style="{StaticResource MapAction}" Click="OnNorth" ToolTipService.ToolTip="Reset bearing to north" AutomationProperties.Name="Reset bearing to north">
                        <Grid Width="20" Height="25" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform x:Name="CompassTransform" /></Grid.RenderTransform><Path Fill="#FF453A" Data="M10,1 L16,13 L10,11 L4,13 Z" /><Path Fill="#A3A3AA" Data="M10,23 L4,13 L10,15 L16,13 Z" /></Grid>
                    </Button>
                    <Button x:Name="ProjectionShortcut" Content="3D" Style="{StaticResource MapAction}" FontSize="14" FontWeight="SemiBold" Click="OnProjection" AutomationProperties.Name="Switch to 2D overhead" ToolTipService.ToolTip="Switch between 2D and 3D" />
                    <Border x:Name="ToolDivider" Height="1" Margin="8,0" Background="{StaticResource AtlasSeparatorBrush}" />
                    <Button x:Name="ZoomInButton" Content="+" Style="{StaticResource MapAction}" Click="OnZoomIn" AutomationProperties.Name="Zoom in" ToolTipService.ToolTip="Zoom in" />
                    <Button x:Name="ZoomOutButton" Content="−" Style="{StaticResource MapAction}" Click="OnZoomOut" AutomationProperties.Name="Zoom out" ToolTipService.ToolTip="Zoom out" />
                </StackPanel>
            </Border>
        </StackPanel>

        <local:GamePanel x:Name="GamePanel" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Border x:Name="PickBanner" Visibility="Collapsed" Background="{StaticResource AtlasSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="12,8" Margin="16" BorderBrush="{StaticResource AtlasSeparatorBrush}" BorderThickness="1" CornerRadius="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock x:Name="PickText" VerticalAlignment="Center" Foreground="{StaticResource AtlasInkBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><Button Grid.Column="1" Content="Cancel" Click="OnCancelPick" AutomationProperties.Name="Cancel map selection" /></Grid>
        </Border>
        <StackPanel x:Name="ScaleBar" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,60" Spacing="2" IsHitTestVisible="False">
            <TextBlock x:Name="ScaleLabel" FontSize="10" Foreground="#3A3A3C" HorizontalAlignment="Center" />
            <Grid x:Name="ScaleRule" Width="70" Height="5"><Border Height="1" Background="#3A3A3C" VerticalAlignment="Bottom" /><Border Width="1" Background="#3A3A3C" HorizontalAlignment="Left" /><Border Width="1" Background="#3A3A3C" HorizontalAlignment="Right" /></Grid>
        </StackPanel>
        <Border x:Name="Footer" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="7,4" Margin="392,0,16,8"
                CornerRadius="7" Background="#DCFFFFFF" MaxWidth="610">
            <StackPanel Spacing="2">
                <TextBlock FontSize="10" Foreground="#636366" TextWrapping="Wrap" Text="OpenFreeMap · OpenMapTiles · © OpenStreetMap" />
                <TextBlock x:Name="EarthCredits" Visibility="Collapsed" TextWrapping="Wrap" FontSize="10" Foreground="#636366"
                           Text="EOxCloudless by EOX IT Services GmbH (Contains modified Copernicus Sentinel data 2016 &amp; 2017) · EOX::Maps · CC BY 4.0" />
                <TextBlock x:Name="ElevationCredits" Visibility="Collapsed" TextWrapping="Wrap" FontSize="10" Foreground="#636366" Text="Terrain Tiles / Mapzen · Elevation data sources in Map information" />
            </StackPanel>
        </Border>
        <Button x:Name="MapInfoButton" Style="{StaticResource AtlasIconButton}" Content="i" FontSize="16" FontWeight="SemiBold"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Background="{StaticResource AtlasSurfaceBrush}"
                AutomationProperties.Name="Map information" ToolTipService.ToolTip="Map information">
            <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedRight">
                    <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Width="270" Spacing="10">
                            <TextBlock Text="Map information" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource AtlasSecondaryBrush}" />
                            <Button Content="Map controls" Click="OnHelp" />
                            <TextBlock Text="Map data" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <StackPanel>
                                <HyperlinkButton Content="© OpenStreetMap contributors" NavigateUri="https://www.openstreetmap.org/copyright" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <HyperlinkButton Content="OpenFreeMap" NavigateUri="https://openfreemap.org" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <HyperlinkButton Content="OpenMapTiles" NavigateUri="https://openmaptiles.org" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            </StackPanel>
                            <StackPanel x:Name="EarthSourceLinks" Visibility="Collapsed">
                                <HyperlinkButton Content="EOxCloudless imagery" NavigateUri="https://cloudless.eox.at/" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <HyperlinkButton Content="EOX::Maps" NavigateUri="https://maps.eox.at/" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <HyperlinkButton Content="Creative Commons BY 4.0" NavigateUri="https://creativecommons.org/licenses/by/4.0/" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            </StackPanel>
                            <StackPanel x:Name="ElevationSourceLinks" Visibility="Collapsed">
                                <HyperlinkButton Content="Terrain Tiles / Mapzen" NavigateUri="https://registry.opendata.aws/terrain-tiles/" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <HyperlinkButton Content="Elevation data sources" NavigateUri="https://github.com/tilezen/joerd/blob/master/docs/attribution.md" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</Page>

<Page
    x:Class="PixelMap.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maps="using:PixelMap.Controls"
    RequestedTheme="Light"
    Background="#142C30">
    <Page.Resources>
        <Style x:Key="HeaderAction" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="#244446" />
            <Setter Property="BorderBrush" Value="#45605E" />
            <Setter Property="Foreground" Value="#F6F4E8" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="MapAction" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Background" Value="#FFFBEE" />
            <Setter Property="Foreground" Value="#193938" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid x:Name="Header" Padding="16,9" Background="#142F32" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="35" Height="35" AutomationProperties.Name="Pixel Atlas">
                    <Canvas Width="32" Height="32">
                        <Path Fill="#91E3BA" Data="M0,10 L16,2 L32,10 L16,18 Z" />
                        <Path Fill="#47B59C" Data="M0,11 L15,19 L15,27 L0,19 Z" />
                        <Path Fill="#E4B778" Data="M17,19 L32,11 L32,19 L17,27 Z" />
                        <Path Fill="#F7F4D9" Data="M9,8 L17,4 L25,8 L17,12 Z" />
                    </Canvas>
                </Viewbox>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pixel Atlas" Foreground="#FCF9EB" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="BrandCaption" Text="UNO  /  OPEN MAP EXPLORER" Foreground="#A4D9C8"
                               FontSize="9" CharacterSpacing="125" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="GuideButton" Content="City guide" Style="{StaticResource HeaderAction}"
                        AutomationProperties.Name="Browse city guide" Click="OnGuide" />
                <Button x:Name="ViewButton" Style="{StaticResource HeaderAction}" AutomationProperties.Name="Map appearance">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="ProjectionItem" Text="Switch to overhead view" Click="OnProjection" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="DayItem" Text="Daylight" Tag="Day" IsChecked="True" Click="OnPalette" />
                            <ToggleMenuFlyoutItem x:Name="DuskItem" Text="Golden hour" Tag="Dusk" Click="OnPalette" />
                            <ToggleMenuFlyoutItem x:Name="NightItem" Text="After dark" Tag="Night" Click="OnPalette" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Share this view" Click="OnShare" />
                            <MenuFlyoutItem Text="Map controls" Click="OnHelp" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="View" />
                        <Path Width="8" Height="4" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="#F6F4E8" Data="M0,0 L8,0 L4,4 Z" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" x:Name="MapArea" Background="#A7C6BD">
            <maps:PixelMapControl x:Name="Map" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  AutomationProperties.Name="Interactive world map" />
            <StackPanel x:Name="SceneDock" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Spacing="6">
                <Border HorizontalAlignment="Left" Padding="3" Background="#FAFFFBEE" BorderBrush="#667666" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <ToggleButton x:Name="MapLayerButton" IsChecked="True" MinWidth="66" Height="36" Padding="9,2" CornerRadius="3"
                                      Click="OnMapLayer" AutomationProperties.Name="Map layer" ToolTipService.ToolTip="Pixel map">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Path Width="13" Height="13" Stretch="Uniform" Fill="#55987C" Data="M0,7 L8,2 L16,7 L8,12 Z M0,10 L8,15 L16,10 L16,13 L8,18 L0,13 Z" />
                                <TextBlock Text="Map" FontSize="13" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="EarthLayerButton" MinWidth="68" Height="36" Padding="9,2" CornerRadius="3"
                                      Click="OnEarthLayer" AutomationProperties.Name="Earth imagery layer" ToolTipService.ToolTip="Natural-color satellite imagery">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Grid Width="13" Height="13"><Ellipse Fill="#658DA4" /><Path Fill="#A7CB8A" Data="M3,2 L7,1 L9,3 L6,5 L7,7 L4,8 L2,5 Z M9,7 L12,6 L12,9 L10,12 L8,11 Z" /></Grid>
                                <TextBlock Text="Earth" FontSize="13" />
                            </StackPanel>
                        </ToggleButton>
                        <Border Width="1" Margin="1,4" Background="#C6CFBE" />
                        <Button x:Name="ProjectionShortcut" Content="3D" MinWidth="40" Height="36" Padding="7,2"
                                Click="OnProjection" AutomationProperties.Name="Switch to 2D overhead"
                                ToolTipService.ToolTip="Toggle overhead or isometric projection" />
                    </StackPanel>
                </Border>
                <Border x:Name="PlaceCard" HorizontalAlignment="Left"
                        Padding="12,8" Background="#F9142F32" BorderBrush="#679789" BorderThickness="1"
                        CornerRadius="4" IsHitTestVisible="False" MaxWidth="335">
                    <StackPanel Spacing="2">
                        <TextBlock Text="DESTINATION" Foreground="#A4D9C8" FontSize="9" CharacterSpacing="135" FontWeight="SemiBold" />
                        <TextBlock x:Name="Destination" Text="Lower Manhattan" Foreground="#FCF9EB" FontSize="16"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MobileStatus" Foreground="#B3CFC1" FontSize="10" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border x:Name="MapTools" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                    Background="#FFFBEE" BorderBrush="#667666" BorderThickness="1" Padding="2" CornerRadius="6">
                <StackPanel x:Name="ToolStack" Spacing="1">
                    <Button Style="{StaticResource MapAction}" Click="OnNorth" ToolTipService.ToolTip="Reset bearing to north"
                            AutomationProperties.Name="Reset bearing to north">
                        <Grid Width="20" Height="24" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform x:Name="CompassTransform" /></Grid.RenderTransform>
                            <Path Fill="#B5523D" Data="M10,1 L16,13 L10,11 L4,13 Z" />
                            <Path Fill="#83988D" Data="M10,23 L4,13 L10,15 L16,13 Z" />
                        </Grid>
                    </Button>
                    <Button Content="+" Style="{StaticResource MapAction}" Click="OnZoomIn" ToolTipService.ToolTip="Zoom in"
                            AutomationProperties.Name="Zoom in" />
                    <Button Content="−" Style="{StaticResource MapAction}" Click="OnZoomOut" ToolTipService.ToolTip="Zoom out"
                            AutomationProperties.Name="Zoom out" />
                    <Border x:Name="ToolDivider" Background="#D7DBCB" Height="1" Margin="7,1" />
                    <Button Style="{StaticResource MapAction}" Click="OnRotateLeft" ToolTipService.ToolTip="Rotate left 45°"
                            AutomationProperties.Name="Rotate left 45 degrees">
                        <Path Stroke="#193938" StrokeThickness="1.8" Data="M7,6 L1,6 L1,0 M1,6 Q4,1 10,2 Q18,3 17,11 Q16,17 10,17" />
                    </Button>
                    <Button Style="{StaticResource MapAction}" Click="OnRotateRight" ToolTipService.ToolTip="Rotate right 45°"
                            AutomationProperties.Name="Rotate right 45 degrees">
                        <Path Stroke="#193938" StrokeThickness="1.8" Data="M11,6 L17,6 L17,0 M17,6 Q14,1 8,2 Q0,3 1,11 Q2,17 8,17" />
                    </Button>
                </StackPanel>
            </Border>
            <StackPanel x:Name="SearchOverlay" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="344" Margin="16" Spacing="6">
                <Border Padding="4" Background="#FFFBEE" BorderBrush="#667666" BorderThickness="1" CornerRadius="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="SearchBox" PlaceholderText="Search places or coordinates" MaxLength="200"
                                 Background="Transparent" BorderThickness="0" Padding="8,6" MinHeight="38"
                                 AutomationProperties.Name="Search places or latitude and longitude" KeyDown="OnSearchKey" TextChanged="OnQueryEdited" />
                        <Button x:Name="SearchButton" Grid.Column="1" Width="42" Height="38" Padding="0"
                                Background="#21564C" BorderBrush="#21564C" CornerRadius="3" Click="OnSearch"
                                AutomationProperties.Name="Search map" ToolTipService.ToolTip="Search">
                            <Path Stroke="#FFFBEE" StrokeThickness="2" Data="M12.5,6.8 A5.7,5.7 0 1 1 1.1,6.8 A5.7,5.7 0 1 1 12.5,6.8 M11.3,11.3 L17.5,17.5" />
                        </Button>
                    </Grid>
                </Border>

                <Border x:Name="Drawer" Visibility="Collapsed" Background="#FFFBEE" BorderBrush="#667666"
                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <StackPanel Spacing="7">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="DrawerHeading" VerticalAlignment="Center" Foreground="#245A4F"
                                       FontSize="12" CharacterSpacing="60" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="×" Width="34" Height="34" Padding="0" FontSize="18"
                                    Background="Transparent" BorderThickness="0" Click="OnCloseDrawer"
                                    AutomationProperties.Name="Close panel" />
                        </Grid>
                        <ScrollViewer x:Name="ResultScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Rows" Spacing="3" />
                        </ScrollViewer>
                        <TextBlock x:Name="DrawerNote" TextWrapping="Wrap" FontSize="12" Foreground="#49665E"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid x:Name="Footer" Grid.Row="2" Padding="12,5" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" Background="#F7F5E8">
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#395950"
                       FontSize="11" TextTrimming="CharacterEllipsis" />
            <StackPanel x:Name="ScaleBar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="5">
                <Border x:Name="ScaleRule" Height="5" Width="45" BorderThickness="1,0,1,1" BorderBrush="#47665A" />
                <TextBlock x:Name="ScaleLabel" VerticalAlignment="Center" FontSize="10" Foreground="#395950" />
            </StackPanel>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#395950">
                <Hyperlink NavigateUri="https://openfreemap.org" Foreground="#30594D">OpenFreeMap</Hyperlink>
                <Run Text=" · " /><Hyperlink NavigateUri="https://openmaptiles.org" Foreground="#30594D">OpenMapTiles</Hyperlink>
                <Run Text=" · " /><Hyperlink NavigateUri="https://www.openstreetmap.org/copyright" Foreground="#30594D">© OpenStreetMap</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="EarthCredits" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,2,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap" FontSize="10" Foreground="#395950">
                <Hyperlink NavigateUri="https://cloudless.eox.at/" Foreground="#30594D">EOxCloudless</Hyperlink>
                <Run Text=" by EOX IT Services GmbH (Contains modified Copernicus Sentinel data 2016 &amp; 2017) · " />
                <Hyperlink NavigateUri="https://maps.eox.at/" Foreground="#30594D">EOX::Maps</Hyperlink>
                <Run Text=" · " /><Hyperlink NavigateUri="https://creativecommons.org/licenses/by/4.0/" Foreground="#30594D">CC BY 4.0</Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Page>

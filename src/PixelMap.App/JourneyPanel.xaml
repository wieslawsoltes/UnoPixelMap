<UserControl
    x:Class="PixelMap.App.JourneyPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Journey planner and player">
    <UserControl.Resources>
        <Style x:Key="SmallAction" TargetType="Button">
            <Setter Property="MinHeight" Value="35" /><Setter Property="MinWidth" Value="38" />
            <Setter Property="Padding" Value="9,4" /><Setter Property="Background" Value="#E7EBDB" />
            <Setter Property="Foreground" Value="#193D37" /><Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource SmallAction}">
            <Setter Property="Background" Value="#21564C" /><Setter Property="Foreground" Value="#FFFBEE" />
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SmallTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#366154" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="CharacterSpacing" Value="95" />
        </Style>
    </UserControl.Resources>
    <Border Background="#FFFBEE" BorderBrush="#607D6F" BorderThickness="1" CornerRadius="7">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
            <Border Background="#193C3C" Padding="12,7" CornerRadius="6,6,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JOURNEYS" Foreground="#9DD4B8" FontWeight="SemiBold" FontSize="9" CharacterSpacing="140" />
                        <TextBlock x:Name="PanelTitle" Text="Route planner" Foreground="#FFFBEE" FontWeight="SemiBold" FontSize="17" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Demo" Style="{StaticResource SmallAction}" Click="OnDemo" AutomationProperties.Name="Load journey demo" />
                    <Button Grid.Column="2" Content="×" Style="{StaticResource SmallAction}" Click="OnClose" AutomationProperties.Name="Close journeys" />
                </Grid>
            </Border>
            <ScrollViewer x:Name="ScrollBody" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Journey details">
                <StackPanel Padding="12,9" Spacing="8">
                    <StackPanel x:Name="PlanPane" Spacing="8" AutomationProperties.Name="Route planning">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5" AutomationProperties.Name="Travel mode and stop order">
                            <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" MinHeight="36" SelectionChanged="OnMode"
                                      AutomationProperties.Name="Travel mode">
                                <ComboBoxItem Tag="Drive" Content="Car" /><ComboBoxItem Tag="Bike" Content="Bicycle" />
                                <ComboBoxItem Tag="Walk" Content="Walking" /><ComboBoxItem Tag="Boat" Content="Boat" />
                                <ComboBoxItem Tag="Train" Content="Train" /><ComboBoxItem Tag="Flight" Content="Aircraft" />
                            </ComboBox>
                            <Button Grid.Column="1" Content="Reverse" Style="{StaticResource SmallAction}" Click="OnReverse" AutomationProperties.Name="Reverse stops" />
                        </Grid>
                        <TextBlock x:Name="ModeNote" TextWrapping="Wrap" Foreground="#52675E" FontSize="11" />
                        <StackPanel x:Name="StopRows" Spacing="3" AutomationProperties.Name="Route stops" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" AutomationProperties.Name="Intermediate stops">
                            <Button Content="+ Via" Style="{StaticResource SmallAction}" Click="OnAddStop" AutomationProperties.Name="Add intermediate stop" />
                            <Button x:Name="RemoveStop" Grid.Column="1" Content="Remove via" Style="{StaticResource SmallAction}" Click="OnRemoveStop"
                                    Visibility="Collapsed" AutomationProperties.Name="Remove selected intermediate stop" />
                        </Grid>
                        <TextBlock x:Name="StopTitle" Text="SET DESTINATION" Style="{StaticResource SmallTitle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" AutomationProperties.Name="Route-stop search">
                            <TextBox x:Name="Query" MaxLength="200" PlaceholderText="Place or latitude, longitude" MinHeight="36"
                                     AutomationProperties.Name="Find a route stop" KeyDown="OnSearchKey" TextChanged="OnSearchEdited" />
                            <Button Grid.Column="1" Content="Find" Style="{StaticResource SmallAction}" Click="OnSearch" AutomationProperties.Name="Search for route stop" />
                        </Grid>
                        <StackPanel x:Name="FoundPlaces" Spacing="3" AutomationProperties.Name="Matching places" />
                        <StackPanel Orientation="Horizontal" Spacing="4" AutomationProperties.Name="Choose a stop from the map">
                            <Button Content="Pick on map" Style="{StaticResource SmallAction}" Click="OnPickMap" AutomationProperties.Name="Pick selected route stop on map" />
                            <Button Content="Use map center" Style="{StaticResource SmallAction}" Click="OnUseCenter" />
                        </StackPanel>
                        <StackPanel x:Name="ExistingTripActions" Visibility="Collapsed" Orientation="Horizontal" Spacing="5" AutomationProperties.Name="Current trip">
                            <Button Content="Back to trip" Click="OnBackToTrip" Style="{StaticResource SmallAction}" />
                            <Button Content="Clear route" Click="OnClear" Style="{StaticResource SmallAction}" />
                        </StackPanel>
                        <Button x:Name="PlanAction" Content="Find route" Style="{StaticResource PrimaryAction}" Click="OnPlan" AutomationProperties.Name="Calculate route" />
                    </StackPanel>

                    <StackPanel x:Name="TripPane" Spacing="7" Visibility="Collapsed" AutomationProperties.Name="Route playback">
                        <TextBlock x:Name="ModeBadge" Style="{StaticResource SmallTitle}" />
                        <TextBlock x:Name="RouteSummary" FontSize="16" FontWeight="SemiBold" Foreground="#193C3C" TextWrapping="Wrap" />
                        <TextBlock x:Name="TripCaveat" TextWrapping="Wrap" Foreground="#52675E" FontSize="11" Visibility="Collapsed" />
                        <ComboBox x:Name="Alternatives" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="OnChoice"
                                  AutomationProperties.Name="Alternative routes" />
                        <StackPanel x:Name="PlayActions" Orientation="Horizontal" Spacing="4" AutomationProperties.Name="Journey playback actions">
                            <Button x:Name="WatchButton" Content="Preview" Style="{StaticResource SmallAction}" Click="OnPreview" AutomationProperties.Name="Preview route" />
                            <Button x:Name="DriveButton" Content="Drive" Style="{StaticResource SmallAction}" Click="OnDrive" AutomationProperties.Name="Take manual control" />
                            <Button x:Name="PauseButton" Content="Pause" Style="{StaticResource SmallAction}" Click="OnPause" AutomationProperties.Name="Pause or resume journey" />
                            <Button Content="Reset" Style="{StaticResource SmallAction}" Click="OnReset" AutomationProperties.Name="Reset journey" />
                        </StackPanel>
                        <TextBlock x:Name="Telemetry" Foreground="#23574F" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock x:Name="TripInstruction" Foreground="#35574D" FontSize="13" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5" AutomationProperties.Name="Route position">
                            <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1000" StepFrequency="1"
                                    ValueChanged="OnSeek" AutomationProperties.Name="Journey progress" />
                            <TextBlock x:Name="PositionText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#35574D" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" AutomationProperties.Name="Playback options">
                            <ComboBox x:Name="Rate" HorizontalAlignment="Stretch" AutomationProperties.Name="Playback speed" SelectionChanged="OnRate">
                                <ComboBoxItem Tag="1" Content="1×" /><ComboBoxItem Tag="4" Content="4×" /><ComboBoxItem Tag="12" Content="12×" />
                            </ComboBox>
                            <ToggleButton x:Name="Follow" Grid.Column="1" Content="Follow" Padding="8,4" Click="OnFollow" AutomationProperties.Name="Follow vehicle" />
                            <ToggleButton x:Name="Sound" Grid.Column="2" Content="Sound" Padding="8,4" Click="OnSound" AutomationProperties.Name="Vehicle sound" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" AutomationProperties.Name="Route navigation">
                            <Button Content="Start" Style="{StaticResource SmallAction}" Click="OnStart" AutomationProperties.Name="Go to route start" />
                            <Button Content="End" Style="{StaticResource SmallAction}" Click="OnEnd" AutomationProperties.Name="Go to route end" />
                            <Button Content="Fit" Style="{StaticResource SmallAction}" Click="OnFit" AutomationProperties.Name="Fit route" />
                            <Button x:Name="CameraButton" Content="Camera" Style="{StaticResource SmallAction}" AutomationProperties.Name="Vehicle camera rig">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Chase" Tag="Chase" Click="OnRig" />
                                        <MenuFlyoutItem Text="North up" Tag="NorthUp" Click="OnRig" />
                                        <MenuFlyoutItem Text="Cockpit" Tag="Cockpit" Click="OnRig" />
                                        <MenuFlyoutItem Text="Orbit" Tag="Orbit" Click="OnRig" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Content="Edit" Style="{StaticResource SmallAction}" Click="OnEdit" AutomationProperties.Name="Edit route stops" />
                        </StackPanel>
                        <Button x:Name="StepButton" Content="Directions" Style="{StaticResource SmallAction}" Click="OnSteps" AutomationProperties.Name="Show or hide directions" />
                        <StackPanel x:Name="StepRows" Visibility="Collapsed" Spacing="3" AutomationProperties.Name="Turn-by-turn directions" />
                        <TextBlock x:Name="RouteSource" TextWrapping="Wrap" Foreground="#52675E" FontSize="11" />
                        <HyperlinkButton x:Name="FixMap" Content="Improve routing data" NavigateUri="https://www.openstreetmap.org/fixthemap"
                                         Padding="0" MinHeight="18" FontSize="11" HorizontalAlignment="Left"
                                         AutomationProperties.Name="Improve OpenStreetMap routing data" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="ManualPad" Grid.Row="2" Margin="12,4" Visibility="Collapsed" Spacing="4" AutomationProperties.Name="Manual vehicle controls">
                <TextBlock x:Name="DrivingTip" Foreground="#50685E" FontSize="12" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="3" AutomationProperties.Name="Steering and speed">
                    <Button x:Name="SteerLeft" Grid.Column="0" Style="{StaticResource SmallAction}" Content="Left" AutomationProperties.Name="Steer left" />
                    <Button x:Name="Gas" Grid.Column="1" Style="{StaticResource SmallAction}" Content="Go" AutomationProperties.Name="Accelerate vehicle" />
                    <Button x:Name="Brake" Grid.Column="2" Style="{StaticResource SmallAction}" Content="Stop" AutomationProperties.Name="Apply vehicle brake" />
                    <Button x:Name="SteerRight" Grid.Column="3" Style="{StaticResource SmallAction}" Content="Right" AutomationProperties.Name="Steer right" />
                    <ToggleButton x:Name="Cruise" Grid.Column="4" Content="Cruise" Padding="6,4" Click="OnCruise" AutomationProperties.Name="Cruise control" />
                </Grid>
                <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="4" AutomationProperties.Name="Vehicle tools">
                    <Button Content="Signal" Style="{StaticResource SmallAction}" Click="OnSignal" AutomationProperties.Name="Vehicle horn or signal" />
                    <Button Grid.Column="1" Content="Recover" Style="{StaticResource SmallAction}" Click="OnRecover" AutomationProperties.Name="Recover at checkpoint" />
                    <Button x:Name="Ascend" Grid.Column="2" Content="Climb" Style="{StaticResource SmallAction}" AutomationProperties.Name="Climb aircraft" />
                    <Button x:Name="Descend" Grid.Column="3" Content="Descend" Style="{StaticResource SmallAction}" AutomationProperties.Name="Descend aircraft" />
                </Grid>
            </StackPanel>
            <TextBlock x:Name="Note" Grid.Row="3" Margin="12,2,12,9" FontSize="12" Foreground="#48675B"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Border>
</UserControl>

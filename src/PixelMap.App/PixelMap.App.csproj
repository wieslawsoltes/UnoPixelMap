<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm</TargetFrameworks>
    <RuntimeIdentifiers>browser-wasm</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <RootNamespace>PixelMap.App</RootNamespace>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer;Skia;GLCanvas</UnoFeatures>
    <ApplicationTitle>Pixel Atlas</ApplicationTitle>
    <ApplicationId>dev.pixelmap.atlas</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <WasmShellWebAppBasePath>./</WasmShellWebAppBasePath>
    <WasmShellIndexHtmlPath>$(MSBuildProjectDirectory)/Platforms/WebAssembly/index.html</WasmShellIndexHtmlPath>
    <WasmShellMonoRuntimeExecutionMode Condition="'$(Configuration)' == 'Release'">InterpreterAndAOT</WasmShellMonoRuntimeExecutionMode>
    <EmccExtraLDFlags>$(EmccExtraLDFlags);-Wl,--wrap=uno_gl_resolve</EmccExtraLDFlags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PixelMap.Controls/PixelMap.Controls.csproj" />
    <WasmShellNativeCompile Include="../PixelMap.Controls/Browser/pixel_map_gl_readback.c" />
    <Content Include="../PixelMap.Audio/Browser/journey-audio.js" Link="audio/journey-audio.js" UnoDeploy="Root" CopyToOutputDirectory="PreserveNewest" />
    <UnoIcon Include="Assets/atlas.svg" />
    <UnoSplashScreen Include="Assets/launch.svg" Color="#142F32" BaseSize="80,80" />
  </ItemGroup>
</Project>
